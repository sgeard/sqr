#!/usr/bin/env tclsh
#
# run_sqrd -- start, stop and inspect a sqrd daemon serving one database.
#
# Every verb names the database it acts on; there is no default, because a
# launcher that guesses which database you meant is the thing this whole
# arrangement exists to avoid.  Ports are not named at all: sqrd binds an
# ephemeral one and records it in <db-dir>/_sqrd, and the clients read it
# from there, so any number of databases can be served at once with nothing
# to allocate and nothing to collide.

namespace eval daemon {
    # The user-facing verbs.  An ensemble dispatches to exactly these, so a
    # proc that is not exported cannot be reached from the command line and
    # there is no separate list of valid commands to keep in step with the
    # implementation.  Unambiguous prefixes work: `run_sqrd stat <db>`.
    # The ensemble is named for the script rather than the namespace, so
    # Tcl's own "wrong # args" and "unknown subcommand" messages name the
    # command the user typed instead of leaking an internal name.
    namespace export start stop restart status help
    namespace ensemble create -command ::run_sqrd

    variable prog [file tail [info script]]
    variable name "sqrd"
    # Relative to the script, not to the caller: the database is an argument,
    # so this gets run from wherever that database happens to be.
    variable loc [file dirname [file normalize [info script]]]

    # 0 = let the OS choose the port.  Pin a number only if something outside
    # must hard-code it (an ODBC DSN carrying an explicit PORT, say).
    variable bind_port 0
    # Filled in from the LISTENING line: what was actually bound.  This and
    # the two below are the start/announced handshake's shared state.
    variable port_no 0
    variable chan ""
    variable ready 0

    # ---- verbs ----------------------------------------------------------

    #! Print how to use this and stop.
    proc help {} {
        usage stdout
        exit 0
    }

    #! Start a daemon on `db` unless one is already serving it.
    #
    # sqrd prints "LISTENING <port>" on stdout as soon as it is bound, and
    # everything else (including the absolute path of the database it is
    # serving) on stderr.  So keep stdout on a pipe and wait for that one
    # line rather than firing and hoping: it says whether the daemon really
    # came up, hands back the pid, and reports the port actually bound --
    # which is what makes an ephemeral port usable.  stderr goes straight to
    # the log so the banner is kept without crossing the pipe.
    proc start {db} {
        variable name
        variable loc
        variable bind_port
        variable port_no
        variable chan
        variable ready
        set id [find $db]
        if {$id != 0} {
            puts "$name already running on $db: pid = $id"
            return
        }
        set dobj [file join $loc $name]
        if {! [file executable $dobj]} {
            error "$dobj is no executable"
        }
        if {! [file isdirectory $db]} {
            error "$db is not a directory"
        }
        set log   [logfile $db]
        set ready 0
        set chan  [open [list | $dobj $db $bind_port 2>> $log] r]
        fileevent $chan readable [namespace code [list announced]]
        vwait [namespace current]::ready
        if {$ready < 0} {
            error "$name failed to start on $db -- see $log"
        }
        puts "$name serving $db on port $port_no: pid = [lindex [pid $chan] 0]"
    }

    #! Stop the daemon serving `db`, if there is one.
    #
    # SIGKILL deliberately: sqrd has no shutdown command by design (a kill
    # mid-write is the crash case its rollback journal already covers), and
    # the ifx runtime prints a traceback on SIGTERM.
    proc stop {db} {
        variable name
        set id [find $db]
        if {$id == 0} {
            puts "$name not running on $db"
            return
        }
        puts "stopping pid = $id"
        exec kill -9 $id
    }

    #! Stop and start again.
    proc restart {db} {
        stop $db
        start $db
    }

    #! Report what is serving `db`, verified rather than assumed.
    #
    # Ask the database, not this script's configuration: sqrbak reads the
    # port sqrd advertised in <db>/_sqrd, connects, and checks that the
    # daemon it reached really is serving this directory.  So the answer is
    # right whoever started the daemon, and right about the port even when
    # the OS chose it.
    proc status {db} {
        variable name
        variable loc
        set bak [file join $loc sqrbak]
        if {! [file executable $bak]} {
            error "$bak is no executable"
        }
        # The pid first: a daemon that is running but unreachable (an older
        # build, a wedged process) is a different story from nothing running
        # at all, and saying so beats silence.
        set id [find $db]
        if {$id != 0} {
            puts "pid = $id"
        }
        if {[catch {exec $bak info $db} out]} {
            if {$id == 0} {
                puts "$name not running on $db"
            }
            puts $out
            return
        }
        puts $out
    }

    # ---- internals ------------------------------------------------------

    # Built from the export list, so a new verb needs no second edit.
    proc usage {chan} {
        variable prog
        set verbs [namespace eval [namespace current] {namespace export}]
        set verbs [lsort [lsearch -all -inline -not -exact $verbs help]]
        puts $chan "Usage:  $prog <[join $verbs |]> <db-dir>"
        puts $chan "        $prog help"
    }

    # The log belongs with the database, not with whoever started the daemon:
    # scoped by the directory it describes, so several daemons cannot
    # interleave into one file and running this from two places does not
    # scatter logs behind you.  The leading underscore follows the engine's
    # convention for files that are not tables (_catalog.dat, _lock,
    # _journal.dat, _sqrd), and db_pack enumerates a fixed file list, so this
    # never finds its way into a backup container.
    proc logfile {db} {
        return [file join $db _sqrd.log]
    }

    # The pid of the daemon serving `db`, or 0.
    #
    # Identify it by the database it is serving, not by name: several sqrd
    # instances can be running, one per database, and killing the wrong one
    # is silent.  Each candidate's argument is resolved against ITS OWN
    # working directory, so any spelling finds the same daemon rather than
    # only the one matching the words used to start it.
    #
    # A ps line is arbitrary text, never a Tcl list (other processes' command
    # lines contain quotes and braces that make list commands throw), so the
    # pid is split off by hand.  ps joins argv with single spaces, so this
    # assumes no argument contains one.
    proc find {db} {
        variable name
        foreach p [split [exec -ignorestderr -- ps -u $::env(USER) -o pid=,args=] \n] {
            set p [string trim $p]
            set sp [string first " " $p]
            if {$sp < 0} {continue}
            set pid   [string range $p 0 $sp-1]
            set words [split [string range $p $sp+1 end] " "]
            if {[llength $words] != 3} {continue}
            if {[file tail [lindex $words 0]] ne $name} {continue}
            if {[same_dir $db [served_dir $pid [lindex $words 1]]]} {
                return $pid
            }
        }
        return 0
    }

    # fileevent handler for the pipe opened by start: consume the one
    # machine-readable line, then stand down.  EOF before it arrives means
    # the daemon died on the way up (bad port, locked database).
    proc announced {} {
        variable chan
        variable port_no
        variable ready
        if {[gets $chan line] < 0} {
            if {[eof $chan]} {
                set ready -1
            }
            return
        }
        fileevent $chan readable {}
        if {[lindex $line 0] eq "LISTENING"} {
            set port_no [lindex $line 1]
            set ready 1
        } else {
            set ready -1
        }
    }

    # The directory a running daemon is actually serving: its argument, made
    # absolute against its own cwd.  /proc is Linux-only, which this launcher
    # is; an unreadable cwd (the process just died) simply fails to match.
    proc served_dir {pid dir} {
        if {[file pathtype $dir] eq "absolute"} {
            return $dir
        }
        if {[catch {file readlink /proc/$pid/cwd} cwd]} {
            return ""
        }
        return [file join $cwd $dir]
    }

    # Do two paths name the same directory?  Device and inode rather than
    # text: `file normalize` does not resolve symbolic links, so comparing
    # strings would miss a daemon started through a different spelling of the
    # same database -- and a stop that silently matches nothing is exactly
    # the failure this launcher exists to avoid.
    proc same_dir {a b} {
        if {[catch {file stat $a sa}]} {return 0}
        if {[catch {file stat $b sb}]} {return 0}
        return [expr {$sa(dev) == $sb(dev) && $sa(ino) == $sb(ino)}]
    }
}

#------------------------------------------------------------------------------
# A misuse -- unknown verb, or the wrong number of arguments -- is reported
# with the usage and a non-zero status; anything else is a real failure and
# says so without the lecture.  Tcl distinguishes the two for us: the
# ensemble raises TCL LOOKUP SUBCOMMAND, a proc's arity raises TCL WRONGARGS,
# and `error` in a verb leaves the code NONE.
if {[catch {run_sqrd {*}$argv} emsg opts]} {
    set code [dict get $opts -errorcode]
    if {[lindex $code 0] eq "TCL" && [lindex $code 1] in {LOOKUP WRONGARGS}} {
        puts stderr $emsg
        daemon::usage stderr
        exit 1
    }
    puts stderr "***Error: $emsg"
    exit 1
}

exit 0
