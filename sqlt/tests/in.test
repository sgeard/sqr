# in.test — IN (list), NOT IN and NOT BETWEEN.

statement ok
CREATE TABLE q(id INTEGER, x REAL, name CHAR(8))

statement ok
INSERT INTO q VALUES(1, 1.5, 'a')

statement ok
INSERT INTO q VALUES(2, 2.0, 'b')

statement ok
INSERT INTO q VALUES(3, 3.5, 'c')

statement ok
INSERT INTO q VALUES(4, 4.0, 'd')

statement ok
INSERT INTO q (id) VALUES(5)

query I nosort
SELECT id FROM q WHERE id IN (1, 3, 99) ORDER BY id
----
1
3

# Numbers compare by value: an integer literal against a REAL column.
query I nosort
SELECT id FROM q WHERE x IN (2, 3.5) ORDER BY id
----
2
3

query T rowsort
SELECT name FROM q WHERE name IN ('d', 'a', 'zz')
----
a
d

# A single-element list.
query I nosort
SELECT id FROM q WHERE id IN (4)
----
4

# NOT IN; the NULL name matches neither IN nor NOT IN.
query I nosort
SELECT id FROM q WHERE name NOT IN ('a', 'd') ORDER BY id
----
2
3

# With an index on the column the answer is the same.
statement ok
CREATE INDEX ON q (id)

query I nosort
SELECT id FROM q WHERE id IN (1, 3, 99) ORDER BY id
----
1
3

query I nosort
SELECT id FROM q WHERE id NOT IN (1, 2, 3) ORDER BY id
----
4
5

# NOT BETWEEN; NULL x is skipped.
query I nosort
SELECT id FROM q WHERE id NOT BETWEEN 2 AND 4 ORDER BY id
----
1
5

query I nosort
SELECT id FROM q WHERE x NOT BETWEEN 2 AND 4 ORDER BY id
----
1

# IN in UPDATE and DELETE.
statement ok
UPDATE q SET name = 'z' WHERE id IN (1, 2)

query I nosort
SELECT id FROM q WHERE name IN ('z') ORDER BY id
----
1
2

statement ok
DELETE FROM q WHERE id NOT IN (1, 2)

query I nosort
SELECT id FROM q ORDER BY id
----
1
2

# The list must be non-empty, of the column's kind, and without NULL.
statement error
SELECT id FROM q WHERE id IN ()

statement error
SELECT id FROM q WHERE id IN (1, 'a')

statement error
SELECT id FROM q WHERE id IN (1, NULL)

# A subquery is not a list.
statement error
SELECT id FROM q WHERE id IN (SELECT id FROM q)
