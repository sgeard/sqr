<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows application manifest: run the process in the UTF-8 code page
     (Windows 10 version 1903 and later), so that a table name holding
     non-ASCII characters becomes a correctly named file.  Link it into any
     executable that uses sqr - see src/sqr_utf8.rc. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
