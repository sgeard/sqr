v1_null.sqr
    A sqr 1.x database (schema version 1), packed with `sqlsh .pack`, for
    the format-upgrade tests in test/utest_sqr.f90.  Written by sqr 1.8.2 on
    a little-endian host.  It cannot be regenerated by this version: the
    statements below were run through the 1.8.2 `sqlsh`.

    CREATE TABLE t (a INT, b INT, c CHAR(8), r REAL);
    INSERT INTO t VALUES (5, NULL, 'x', 1.5);
    INSERT INTO t VALUES (5, 1, 'y', NULL);
    INSERT INTO t VALUES (6, NULL, NULL, 2.5);
    INSERT INTO t VALUES (NULL, 7, 'z', 3.5);
    INSERT INTO t VALUES (7, 2, 'y', 4.5);
    INSERT INTO t VALUES (9, 9, 'q', 9.5);
    DELETE FROM t WHERE a = 9;
    CREATE INDEX ON t (a, b);
    CREATE INDEX ON t (c);
    CREATE INDEX ON t (r);
    CREATE TABLE u (k INT, v CHAR(4));
    INSERT INTO u VALUES (0, 'zero');
    INSERT INTO u VALUES (1, 'one');
    INSERT INTO u VALUES (NULL, 'n1');
    INSERT INTO u VALUES (NULL, 'n2');
    CREATE UNIQUE INDEX ON u (k);
    CREATE TABLE e (x INT);
